# VEXOcar API · copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.
# Sem .env a API roda inteira no "modo local" (banco em arquivo, login próprio, fotos na pasta uploads/).

PORT=3000

# ---------- Firebase (banco Firestore + login) ----------
# 1) Chave de serviço: baixe em Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
#    e salve como serviceAccountKey.json nesta pasta (ou cole o JSON inteiro em FIREBASE_SERVICE_ACCOUNT, no Render).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# 2) Config do app web: Firebase > Configurações do projeto > Seus apps > Web (</>) > apiKey
FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=vexocar.firebaseapp.com
# FIREBASE_PROJECT_ID=vexocar

# ---------- Cloudinary (fotos) ----------
# Painel do Cloudinary > Dashboard > "API environment variable"
CLOUDINARY_URL=

# ---------- Publicação (etapa 12) ----------
# Sites que podem chamar a API, separados por vírgula
# ORIGENS_PERMITIDAS=https://mmarcatoricardo.github.io
